from __future__ import annotations

import threading
import tkinter as tk

from ubuntu_ai.agent_loop.models import LoopSnapshot, LoopState
from ubuntu_ai.gui.backend import GUIBackend

BACKGROUND = "#0f1117"
SURFACE = "#181b22"
SURFACE_ALT = "#20232b"
TEXT = "#f2f3f5"
TEXT_MUTED = "#a9adb7"
ACCENT = "#8ab4f8"
SUCCESS = "#81c995"
WARNING = "#fdd663"
ERROR = "#f28b82"
BORDER = "#30343d"


class UbuntuAIApp:
    """Interface desktop do Ubuntu AI Assistant."""

    def __init__(self) -> None:
        self._backend = GUIBackend()
        self._busy = False

        self.root = tk.Tk()
        self.root.title("Ubuntu AI Assistant")
        self.root.geometry("1000x720")
        self.root.minsize(760, 560)
        self.root.configure(bg=BACKGROUND)

        self._build_interface()
        self._show_welcome()

    def _build_interface(self) -> None:
        header = tk.Frame(
            self.root,
            bg=BACKGROUND,
            padx=28,
            pady=18,
        )
        header.pack(fill=tk.X)

        tk.Label(
            header,
            text="Ubuntu AI",
            bg=BACKGROUND,
            fg=TEXT,
            font=("Sans", 15, "bold"),
        ).pack(side=tk.LEFT)

        self.status_label = tk.Label(
            header,
            text="●  Pronto",
            bg=BACKGROUND,
            fg=SUCCESS,
            font=("Sans", 10),
        )
        self.status_label.pack(side=tk.RIGHT)

        self.content = tk.Frame(
            self.root,
            bg=BACKGROUND,
        )
        self.content.pack(
            fill=tk.BOTH,
            expand=True,
            padx=28,
        )

        self.canvas = tk.Canvas(
            self.content,
            bg=BACKGROUND,
            highlightthickness=0,
        )
        self.scrollbar = tk.Scrollbar(
            self.content,
            orient=tk.VERTICAL,
            command=self.canvas.yview,
        )

        self.messages = tk.Frame(
            self.canvas,
            bg=BACKGROUND,
        )

        self.messages.bind(
            "<Configure>",
            lambda _event: self.canvas.configure(
                scrollregion=self.canvas.bbox("all")
            ),
        )

        self.canvas_window = self.canvas.create_window(
            (0, 0),
            window=self.messages,
            anchor="nw",
        )

        self.canvas.bind("<Configure>", self._resize_messages)

        self.canvas.configure(
            yscrollcommand=self.scrollbar.set,
        )

        self.canvas.pack(
            side=tk.LEFT,
            fill=tk.BOTH,
            expand=True,
        )

        self.scrollbar.pack(
            side=tk.RIGHT,
            fill=tk.Y,
        )

        composer_outer = tk.Frame(
            self.root,
            bg=BACKGROUND,
            padx=28,
            pady=24,
        )
        composer_outer.pack(fill=tk.X)

        composer = tk.Frame(
            composer_outer,
            bg=SURFACE_ALT,
            padx=18,
            pady=12,
            highlightbackground=BORDER,
            highlightthickness=1,
        )
        composer.pack(
            fill=tk.X,
            padx=100,
        )

        self.request_entry = tk.Entry(
            composer,
            bg=SURFACE_ALT,
            fg=TEXT,
            insertbackground=TEXT,
            relief=tk.FLAT,
            borderwidth=0,
            font=("Sans", 12),
        )
        self.request_entry.pack(
            side=tk.LEFT,
            fill=tk.X,
            expand=True,
            ipady=8,
        )

        self.request_entry.bind(
            "<Return>",
            self._on_enter,
        )

        self.send_button = tk.Button(
            composer,
            text="Enviar",
            command=self.submit,
            bg=ACCENT,
            fg="#101318",
            activebackground="#a8c7fa",
            activeforeground="#101318",
            relief=tk.FLAT,
            borderwidth=0,
            padx=18,
            pady=8,
            cursor="hand2",
            font=("Sans", 10, "bold"),
        )
        self.send_button.pack(
            side=tk.RIGHT,
            padx=(12, 0),
        )

        self.request_entry.focus_set()

    def _show_welcome(self) -> None:
        welcome = tk.Frame(
            self.messages,
            bg=BACKGROUND,
        )
        welcome.pack(
            fill=tk.X,
            pady=(100, 30),
        )

        tk.Label(
            welcome,
            text="Como posso ajudar?",
            bg=BACKGROUND,
            fg=TEXT,
            font=("Sans", 28, "bold"),
        ).pack()

        tk.Label(
            welcome,
            text="Administre seu Ubuntu usando linguagem natural.",
            bg=BACKGROUND,
            fg=TEXT_MUTED,
            font=("Sans", 12),
        ).pack(pady=(8, 0))

    def submit(self) -> None:
        if self._busy:
            return

        request = self.request_entry.get().strip()

        if not request:
            return

        self.request_entry.delete(0, tk.END)
        self._add_user_message(request)
        self._set_busy(True, "Analisando")

        threading.Thread(
            target=self._start_request,
            args=(request,),
            daemon=True,
        ).start()

    def _start_request(self, request: str) -> None:
        try:
            snapshot = self._backend.start(request)
        except Exception as exc:
            self.root.after(
                0,
                self._show_error,
                str(exc),
            )
            return

        self.root.after(
            0,
            self._show_snapshot,
            snapshot,
        )

    def _show_snapshot(self, snapshot: LoopSnapshot) -> None:
        self._set_busy(False)

        pending = snapshot.pending_plan

        if pending is not None and pending.pipeline_result is not None:
            plan = pending.pipeline_result.plan

            if plan is not None:
                self._add_plan_card(
                    snapshot,
                    plan,
                )
                return

        self._add_system_message(
            self._state_message(snapshot),
        )

    def _add_user_message(self, message: str) -> None:
        frame = tk.Frame(
            self.messages,
            bg=BACKGROUND,
        )
        frame.pack(
            fill=tk.X,
            pady=10,
            padx=100,
        )

        bubble = tk.Label(
            frame,
            text=message,
            bg=SURFACE_ALT,
            fg=TEXT,
            font=("Sans", 11),
            justify=tk.LEFT,
            wraplength=560,
            padx=16,
            pady=12,
        )
        bubble.pack(side=tk.RIGHT)

        self._scroll_bottom()

    def _add_system_message(self, message: str) -> None:
        frame = tk.Frame(
            self.messages,
            bg=BACKGROUND,
        )
        frame.pack(
            fill=tk.X,
            padx=100,
            pady=12,
        )

        tk.Label(
            frame,
            text=message,
            bg=BACKGROUND,
            fg=TEXT,
            font=("Sans", 11),
            justify=tk.LEFT,
            wraplength=650,
        ).pack(anchor="w")

        self._scroll_bottom()

    def _add_plan_card(
        self,
        snapshot: LoopSnapshot,
        plan: object,
    ) -> None:
        outer = tk.Frame(
            self.messages,
            bg=BACKGROUND,
        )
        outer.pack(
            fill=tk.X,
            padx=100,
            pady=18,
        )

        card = tk.Frame(
            outer,
            bg=SURFACE,
            padx=22,
            pady=20,
            highlightbackground=BORDER,
            highlightthickness=1,
        )
        card.pack(fill=tk.X)

        risk = getattr(plan, "risk", None)
        risk_value = getattr(risk, "value", risk)

        header = tk.Frame(
            card,
            bg=SURFACE,
        )
        header.pack(fill=tk.X)

        tk.Label(
            header,
            text=str(getattr(plan, "goal", "Plano proposto")),
            bg=SURFACE,
            fg=TEXT,
            font=("Sans", 15, "bold"),
        ).pack(side=tk.LEFT)

        tk.Label(
            header,
            text=f"Risco {risk_value}",
            bg=SURFACE,
            fg=self._risk_color(str(risk_value)),
            font=("Sans", 10, "bold"),
        ).pack(side=tk.RIGHT)

        planner = getattr(plan, "planner", None)

        if planner:
            tk.Label(
                card,
                text=f"Planner: {planner}",
                bg=SURFACE,
                fg=TEXT_MUTED,
                font=("Sans", 9),
            ).pack(
                anchor="w",
                pady=(5, 14),
            )

        for index, step in enumerate(
            getattr(plan, "steps", ()) or (),
            start=1,
        ):
            title = getattr(step, "title", f"Etapa {index}")

            tk.Label(
                card,
                text=f"{index}. {title}",
                bg=SURFACE,
                fg=TEXT,
                font=("Sans", 11, "bold"),
            ).pack(
                anchor="w",
                pady=(8, 3),
            )

            description = getattr(step, "description", "")

            if description:
                tk.Label(
                    card,
                    text=description,
                    bg=SURFACE,
                    fg=TEXT_MUTED,
                    justify=tk.LEFT,
                    wraplength=620,
                    font=("Sans", 10),
                ).pack(anchor="w")

            command = getattr(step, "command", ())

            if command:
                if isinstance(command, (list, tuple)):
                    command_text = " ".join(
                        str(item) for item in command
                    )
                else:
                    command_text = str(command)

                command_box = tk.Label(
                    card,
                    text=f"$ {command_text}",
                    bg="#101218",
                    fg=SUCCESS,
                    justify=tk.LEFT,
                    anchor="w",
                    font=("Monospace", 10),
                    padx=12,
                    pady=10,
                )
                command_box.pack(
                    fill=tk.X,
                    pady=(8, 5),
                )

        if snapshot.requires_confirmation:
            actions = tk.Frame(
                card,
                bg=SURFACE,
            )
            actions.pack(
                fill=tk.X,
                pady=(18, 0),
            )

            tk.Button(
                actions,
                text="Cancelar",
                command=self.cancel,
                bg=SURFACE_ALT,
                fg=TEXT,
                activebackground=BORDER,
                activeforeground=TEXT,
                relief=tk.FLAT,
                padx=18,
                pady=9,
                cursor="hand2",
            ).pack(
                side=tk.RIGHT,
                padx=(8, 0),
            )

            tk.Button(
                actions,
                text="Confirmar e executar",
                command=self.confirm,
                bg=ACCENT,
                fg="#101318",
                activebackground="#a8c7fa",
                activeforeground="#101318",
                relief=tk.FLAT,
                padx=18,
                pady=9,
                cursor="hand2",
                font=("Sans", 10, "bold"),
            ).pack(side=tk.RIGHT)

        self._scroll_bottom()

    def confirm(self) -> None:
        if self._busy:
            return

        self._set_busy(True, "Executando")

        threading.Thread(
            target=self._confirm_request,
            daemon=True,
        ).start()

    def _confirm_request(self) -> None:
        try:
            snapshot = self._backend.confirm()
        except Exception as exc:
            self.root.after(
                0,
                self._show_error,
                str(exc),
            )
            return

        self.root.after(
            0,
            self._show_execution,
            snapshot,
        )

    def _show_execution(
        self,
        snapshot: LoopSnapshot,
    ) -> None:
        self._set_busy(False)

        if snapshot.records:
            record = snapshot.records[-1]

            for result in record.execution_results:
                self._add_execution_result(result)

        if snapshot.requires_confirmation:
            pending = snapshot.pending_plan

            if pending is not None and pending.pipeline_result is not None:
                plan = pending.pipeline_result.plan

                if plan is not None:
                    self._add_plan_card(
                        snapshot,
                        plan,
                    )
                    return

        self._add_system_message(
            self._state_message(snapshot),
        )

    def _add_execution_result(self, result: object) -> None:
        status = getattr(result, "status", None)
        status_value = getattr(status, "value", status)

        command = getattr(result, "command", None)
        message = getattr(result, "message", "")
        stdout = getattr(result, "stdout", "")
        stderr = getattr(result, "stderr", "")
        return_code = getattr(result, "return_code", None)

        outer = tk.Frame(
            self.messages,
            bg=BACKGROUND,
        )
        outer.pack(
            fill=tk.X,
            padx=100,
            pady=12,
        )

        card = tk.Frame(
            outer,
            bg=SURFACE,
            padx=20,
            pady=16,
            highlightbackground=BORDER,
            highlightthickness=1,
        )
        card.pack(fill=tk.X)

        successful = str(status_value) in {
            "approved",
            "executed",
        }

        tk.Label(
            card,
            text=(
                "✓ Execução concluída"
                if successful
                else "⚠ Execução não concluída"
            ),
            bg=SURFACE,
            fg=SUCCESS if successful else ERROR,
            font=("Sans", 12, "bold"),
        ).pack(anchor="w")

        if command:
            tk.Label(
                card,
                text=f"$ {command}",
                bg="#101218",
                fg=SUCCESS,
                font=("Monospace", 10),
                anchor="w",
                padx=12,
                pady=10,
            ).pack(
                fill=tk.X,
                pady=(12, 8),
            )

        if message:
            tk.Label(
                card,
                text=str(message),
                bg=SURFACE,
                fg=TEXT_MUTED,
                justify=tk.LEFT,
                wraplength=620,
            ).pack(anchor="w")

        output = stdout or stderr

        if output:
            text = tk.Text(
                card,
                bg="#101218",
                fg=TEXT,
                insertbackground=TEXT,
                relief=tk.FLAT,
                borderwidth=0,
                font=("Monospace", 9),
                height=min(
                    max(len(str(output).splitlines()), 3),
                    14,
                ),
                wrap=tk.NONE,
            )

            text.insert("1.0", str(output))
            text.configure(state=tk.DISABLED)

            text.pack(
                fill=tk.X,
                pady=(12, 0),
            )

        if return_code is not None:
            tk.Label(
                card,
                text=f"Exit code: {return_code}",
                bg=SURFACE,
                fg=TEXT_MUTED,
                font=("Sans", 8),
            ).pack(
                anchor="e",
                pady=(8, 0),
            )

        self._scroll_bottom()

    def cancel(self) -> None:
        if self._busy:
            return

        try:
            snapshot = self._backend.cancel()
        except Exception as exc:
            self._show_error(str(exc))
            return

        self._add_system_message(
            self._state_message(snapshot),
        )

    def _show_error(self, message: str) -> None:
        self._set_busy(False)

        self._add_system_message(
            f"Erro: {message}",
        )

        self.status_label.configure(
            text="●  Erro",
            fg=ERROR,
        )

    def _set_busy(
        self,
        busy: bool,
        label: str = "Pronto",
    ) -> None:
        self._busy = busy

        if busy:
            self.status_label.configure(
                text=f"●  {label}...",
                fg=WARNING,
            )
            self.send_button.configure(state=tk.DISABLED)
            self.request_entry.configure(state=tk.DISABLED)
        else:
            self.status_label.configure(
                text="●  Pronto",
                fg=SUCCESS,
            )
            self.send_button.configure(state=tk.NORMAL)
            self.request_entry.configure(state=tk.NORMAL)
            self.request_entry.focus_set()

    @staticmethod
    def _state_message(snapshot: LoopSnapshot) -> str:
        messages = {
            LoopState.COMPLETED: "Operação concluída com sucesso.",
            LoopState.BLOCKED: "A operação foi bloqueada pela política de segurança.",
            LoopState.FAILED: "Não foi possível concluir a operação.",
            LoopState.CANCELLED: "Operação cancelada.",
            LoopState.WAITING_CONFIRMATION: "O plano aguarda sua confirmação.",
        }

        return messages.get(
            snapshot.state,
            f"Estado: {snapshot.state.value}",
        )

    @staticmethod
    def _risk_color(risk: str) -> str:
        normalized = risk.lower()

        if normalized == "low":
            return SUCCESS

        if normalized == "medium":
            return WARNING

        return ERROR

    def _resize_messages(self, event: tk.Event) -> None:
        self.canvas.itemconfigure(
            self.canvas_window,
            width=event.width,
        )

    def _scroll_bottom(self) -> None:
        self.root.after(
            20,
            lambda: self.canvas.yview_moveto(1.0),
        )

    def _on_enter(self, _event: tk.Event) -> None:
        self.submit()

    def run(self) -> None:
        self.root.mainloop()


def main() -> None:
    UbuntuAIApp().run()


if __name__ == "__main__":
    main()
